# Copy to .env.local and fill in. Nothing here is required to start the app locally
# except ANTHROPIC_API_KEY, which turns on the AI evaluator.

# --- AI evaluator (Anthropic) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Sessions ---
# Random string used to sign the demo sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Optional: require this code once before using the demo (recommended once deployed).
# DEMO_ACCESS_CODE=

# Self-guided demo mode (guided tour, auto-loaded sample data, reset). On unless "false".
# DEMO_MODE=false

# --- Database ---
# Leave empty locally: an embedded Postgres (PGlite) is stored in ~/.msa-rfp-portal/pglite.
# On Vercel, set this to a Neon/Postgres connection string for persistent data.
# DATABASE_URL=
# PGLITE_DIR=

# --- File uploads ---
# Leave empty locally (files are stored in the database).
# On Vercel, connect a Blob store so large decks upload directly (serverless bodies are capped at ~4.5 MB).
# BLOB_READ_WRITE_TOKEN=

# --- Cron (Vercel) ---
# Protects /api/cron/evaluate, which evaluates any response the AI hasn't read yet.
# CRON_SECRET=
